dragon_firm: dragon_firmware
dragon_path: dragon_firmware/keyboards/nullbitsco/tidbit/keymaps/dragonpad/

[clone]
	git clone -b rp2040_clean https://github.com/jaygreco/$dragon_firm
	push_dir $dragon_firm
	git submodule update
	pop_dir

[copy]
	mkdir -p $dragon_path
	cp keymap.c config.h rules.mk $dragon_path

[build]
	also copy
	push_dir $dragon_firm
	qmk compile -kb nullbitsco/tidbit/rp2040 -km dragonpad
